{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/app.ts",
    "src/ts/**/*.ts",
    "src/types.d.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}